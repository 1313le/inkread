node_modules/
dist/
dist-*/
# dist\win-unpacked\resources\app.asar 会被独占（unlink 必 EBUSY）：Restart Manager 实测持有者是
# ZCode.exe（本工程活在它的 workspace 目录里，它索引了这颗 42MB asar），先前记成 360 是误判。
# 成品轮固定落 workspace 索引面之外的目录，再把安装包复制回 dist/ 归档。
dist2/
backups/
.work/
*.log

# scripts/build-fonts.py 的本机虚拟环境（34MB，fonttools + brotli），
# 子集化是可复现构建：只需要脚本与名册进仓库，环境各机自举。
.venv-fonts/
__pycache__/

# 安卓工程（Capacitor + 原生 Gradle）：只保留源码与 www 镜像，
# 依赖与构建产物不进仓库（构建产物 >100MB，且随每次构建变化）
android/node_modules/
android/.gradle/
android/android/.gradle/
android/android/build/
android/android/app/build/
android/android/capacitor-cordova-android-plugins/build/
android/android/local.properties
android/**/*.apk
android/**/*.aab

# 注意：根目录 build/ 是打包用的应用图标（icon.png / icon.svg / icon@256 / icon@64），
# 全部需要进仓库，不要忽略。
