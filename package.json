{
  "name": "inkread",
  "version": "2.19.0",
  "private": true,
  "description": "墨读 InkRead —— 水墨屏阅读器（书架 / 阅读 / 笔记 / 任务 / 主脑）",
  "author": "InkRead",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "serve": "node scripts/serve.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-edge-tts": "^1.2.10",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.inkread.app",
    "productName": "InkRead",
    "directories": {
      "output": "dist"
    },
    "files": [
      "ink-reader/**/*",
      "electron/**/*",
      "scripts/serve.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/types/**",
      "!**/demo/**",
      "!**/examples/**",
      "!**/docs/**",
      "!**/.github/**",
      "!**/node_modules/*/doc*/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "InkRead-Setup-${version}.${ext}",
      "shortcutName": "墨读 InkRead",
      "uninstallDisplayName": "墨读 InkRead"
    }
  }
}
